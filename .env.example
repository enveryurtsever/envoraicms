# Envoraicms — .env.local sample
# Copy this file to .env.local and fill in the values.
# WordPress-style: only DB credentials are required here.

# --- Database (required) ---
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Optional ---
# DB_PORT=5432              # default 5432
# DB_SSL=disable            # require | disable, default disable

# Cron jobs are triggered every 60s from inside the Next.js process
# (instrumentation.ts → lib/ingest/scheduler.ts). Disable with:
# SCHEDULER_DISABLED=1

# Site URL — also used as the source for the PM2 app name (hostname is
# extracted, "www." prefix stripped) so multi-site hosts get distinct
# `pm2 list` entries automatically. Set this BEFORE
# `pm2 start deploy/ecosystem.config.js` if you want the app named after
# your domain. Also written to the DB by the install wizard.
SITE_URL=http://localhost:3002

# Optional override for the PM2 app name. If unset, derived from SITE_URL
# (falls back to "envoraicms" when SITE_URL is empty/localhost). Set this
# when you want a fixed conventional name regardless of SITE_URL.
# PM2_APP_NAME=techawave.com

NODE_ENV=development

# Next.js listening port. Default 3000; pick anything free.
PORT=3002

# --- In-place updates from GitHub ---
# Enables the /admin/system/update page to take a backup, pull the latest
# release tag, rebuild, migrate, and reload via PM2. Without this flag the
# page is read-only (version detection only). Required for security:
# treats every update as an explicit opt-in per environment.
# UPDATER_ENABLED=true
#
# Override the GitHub repo the updater pulls from. Default is the upstream
# project; fork users should point this at their own slug.
# UPDATER_GITHUB_REPO=your-org/your-fork

# Notes:
# - Don't quote DB_PASSWORD. dotenv reads everything after the first = as
#   the raw value; special characters (=)/:%* etc.) pass through without
#   needing URL-encoding.
# - The legacy DATABASE_URL=postgres://... format still works for backward
#   compatibility — use that if you prefer.
# - Post-install secrets (cookie signing, etc.) are stored in the Settings
#   table — you don't need to add secrets to env.
