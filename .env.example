# Envoraicms — copy to .env.local and fill in.

# Database (required). Wrap DB_PASSWORD in single quotes if it contains
# `&`, `*`, `:`, `$`, `#`, spaces, or other shell-special characters.
DB_HOST=localhost
DB_NAME=envoraicms
DB_USER=envoraicms
DB_PASSWORD='change-me'
# DB_PORT=5432
# DB_SSL=require   # for remote DB

# Public origin. Also drives the PM2 app name (hostname is extracted,
# leading "www." stripped). Set this BEFORE `pm2 start`.
SITE_URL=http://localhost:3002

# Optional override for the PM2 app name. Falls back to SITE_URL's
# hostname, then to "envoraicms".
# PM2_APP_NAME=example.com

NODE_ENV=development

# Next.js listening port.
PORT=3002

# In-place updates from GitHub via /admin/system/update.
UPDATER_ENABLED=true
# UPDATER_GITHUB_REPO=your-org/your-fork   # only if you forked
