# Envoraicms — .env.local örneği
# Bu dosyayı .env.local olarak kopyala ve değerleri doldur.
# Tıpkı WordPress wp-config.php gibi: yalnızca DB bilgisi.

# --- Database (zorunlu) ---
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Opsiyonel ---
# DB_PORT=5432              # default 5432
# DB_SSL=disable            # require | disable, default disable

# Site URL — install sihirbazı bunu DB'ye yazıyor; env'de zorunlu değil.
SITE_URL=http://localhost:3000

NODE_ENV=development

# Notlar:
# - DB_PASSWORD'da tırnak kullanma. dotenv ilk = den sonrasını ham değer
#   olarak okur; özel karakterler (=)/:%* gibi) URL-encode olmadan geçer.
# - Eski DATABASE_URL=postgres://... formatı geriye uyumluluk için hâlâ
#   destekleniyor; istersen onu kullanabilirsin.
# - Kurulum sonrası secret'lar (cookie imzalama vs.) DB'de Settings tablosunda
#   tutuluyor — env'e secret eklemen gerekmiyor.
